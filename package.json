{
  "name": "ukki",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "node init && expo start",
    "start:dev": "node init && APP_ENV=dev expo start",
    "start:stage": "node init && APP_ENV=stage expo start",
    "start:prod": "node init && APP_ENV=prod expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "node init && APP_ENV=dev eas build --profile production-dev",
    "build:stage": "node init && APP_ENV=stage eas build --profile production-stage",
    "build:prod": "node init && APP_ENV=prod eas build --profile production",
    "update:dev": "APP_ENV=dev eas update --channel dev",
    "update:stage": "APP_ENV=stage eas update --channel stage",
    "update:prod": "APP_ENV=prod eas update --channel production",
    "lint": "expo lint",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@realm/react": "^0.20.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.90.20",
    "axios": "^1.13.5",
    "dotenv": "^17.2.4",
    "expo": "~54.0.33",
    "expo-application": "^7.0.8",
    "expo-auth-session": "^7.0.10",
    "expo-constants": "^18.0.13",
    "expo-device": "^8.0.10",
    "expo-file-system": "^19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linking": "~8.0.11",
    "expo-localization": "^17.0.8",
    "expo-network": "~8.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "posthog-react-native": "^4.32.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-flash-message": "^0.4.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "realm": "^20.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@types/react": "~19.1.0",
    "@types/styled-components": "^5.1.36",
    "@types/styled-components-react-native": "^5.2.5",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "styled-components": "^6.3.9",
    "typescript": "~5.9.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "private": true
}
